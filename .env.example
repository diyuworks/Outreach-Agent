# Copy this file to .env and fill in real values ONLY IF you want live sending.
# Leave any of these blank and that channel runs in safe DRY RUN (demo) mode.

# --- Dashboard login (HTTP Basic Auth) ---
AUTH_USERNAME=
AUTH_PASSWORD=

# --- Email (Resend HTTPS API / Gmail SMTP) ---
# Resend (Recommended for Cloud / Render): Get free key at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Gmail SMTP (For Localhost): Generate an App Password at: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- SMS Provider Selection ---
SMS_PROVIDER=twilio          # "twilio" or "fast2sms"

# --- Twilio (SMS + WhatsApp Sandbox — free trial: 100 SMS + 100 WhatsApp msgs) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Fast2SMS (India-specific, cheaper — for production later) ---
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=FSTSMS

# --- WhatsApp Provider Selection ---
WHATSAPP_PROVIDER=twilio       # "twilio" or "meta"

# --- WhatsApp (Meta Cloud API - requires Business verification + template approval) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=

# --- Escalation Alerts ---
SALES_REP_ALERT_EMAIL=
# --- Escalation SMS Alert (optional, in addition to email) ---
SALES_REP_ALERT_PHONE=
SLACK_WEBHOOK_URL=

# --- ETA / response-time confirmation to the lead ---
AUTO_SEND_ETA_CONFIRMATION=true
ESCALATION_RESPONSE_ETA_HOURS=2

# --- Inbound webhook listener ---
WEBHOOK_PORT=5001
# Set this to the full public ngrok HTTPS URL + /webhook each time ngrok
# is restarted (ngrok free-tier URLs change on restart). Example:
#   WEBHOOK_PUBLIC_URL=https://abc123.ngrok-free.app/webhook
# When set, the webhook server validates Twilio's X-Twilio-Signature header
# to reject spoofed requests. When blank, signature validation is skipped
# (safe for local-only testing, but do NOT leave blank when exposed publicly).
WEBHOOK_PUBLIC_URL=

# --- Hetvi Lead Discovery API (primary lead source) ---
LEAD_API_URL=http://192.168.1.22:4000/api/leads/

# --- Groq Voice Assistant / Speech-To-Text & Intent API ---
STT_PROVIDER=groq
GROQ_API_KEY=

